---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const lectures = await getCollection('lectures')
  return lectures.map((lecture) => ({
    params: { id: lecture.id },
    props: lecture,
  }))
}

const lecture = Astro.props
const { Content } = await render(lecture)
---

<Layout>
  <PageHead slot="head" title={lecture.data.title} />
  <Breadcrumbs
    items={[
      {
        label: 'Lectures',
        href: '/lectures',
        icon: 'lucide:graduation-cap',
      },
      { label: lecture.data.title, icon: 'lucide:file-text' },
    ]}
  />

  <section>
    <div class="min-w-full">
      <div class="mb-6 flex flex-col gap-1">
        <h1 class="text-3xl leading-tight font-medium sm:text-4xl">
          {lecture.data.title}
        </h1>
        <div class="flex items-center gap-3 text-sm text-muted-foreground">
          {lecture.data.course && <span>{lecture.data.course}</span>}
          {lecture.data.course && lecture.data.date && <span>&middot;</span>}
          {lecture.data.date && (
            <span>
              {lecture.data.date.toLocaleDateString('en-US', {
                month: 'long',
                day: 'numeric',
                year: 'numeric',
              })}
            </span>
          )}
        </div>
        {
          lecture.data.tags && lecture.data.tags.length > 0 && (
            <div class="mt-1 flex flex-wrap gap-1.5">
              {lecture.data.tags.map((tag) => (
                <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </div>

      {
        lecture.data.pdf && (
          <div class="mb-8">
            <a
              href={`/lectures/${lecture.data.pdf}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-muted-foreground hover:text-foreground"
            >
              Open PDF in new tab &rarr;
            </a>
            <iframe
              src={`/lectures/${lecture.data.pdf}`}
              class="mt-3 w-full rounded-md border"
              style="height: 80vh;"
              loading="lazy"
            />
          </div>
        )
      }

      <article class="prose">
        <Content />
      </article>

      <div class="mt-12 border-t pt-6">
        <Link href="/lectures" class="text-sm text-muted-foreground hover:text-foreground">
          &larr; Back to all lectures
        </Link>
      </div>
    </div>
  </section>
</Layout>
