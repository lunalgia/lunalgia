---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import FileTree from '@/components/FileTree.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { readUniTree, uniHref } from '@/lib/file-tree'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const lectures = await getCollection('lectures')
  return lectures.map((lecture) => ({
    params: { id: lecture.id },
    props: lecture,
  }))
}

const lecture = Astro.props
const { Content } = await render(lecture)

const pdfHref = lecture.data.pdf
  ? lecture.data.folder
    ? uniHref(lecture.data.folder, lecture.data.pdf)
    : `/lectures/${lecture.data.pdf}`
  : null

const fileTree = lecture.data.folder
  ? await readUniTree(lecture.data.folder)
  : []
---

<Layout>
  <PageHead slot="head" title={lecture.data.title} />
  <Breadcrumbs
    items={[
      {
        label: 'Lectures',
        href: '/lectures',
        icon: 'lucide:graduation-cap',
      },
      { label: lecture.data.title, icon: 'lucide:file-text' },
    ]}
  />

  <section>
    <div class="min-w-full">
      <div class="mb-6 flex flex-col gap-1">
        <h1 class="text-3xl leading-tight font-medium sm:text-4xl">
          {lecture.data.title}
        </h1>
        <div class="text-muted-foreground flex items-center gap-3 text-sm">
          {lecture.data.course && <span>{lecture.data.course}</span>}
          {lecture.data.course && lecture.data.date && <span>&middot;</span>}
          {
            lecture.data.date && (
              <span>
                {lecture.data.date.toLocaleDateString('en-US', {
                  month: 'long',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </span>
            )
          }
        </div>
        {
          lecture.data.tags && lecture.data.tags.length > 0 && (
            <div class="mt-1 flex flex-wrap gap-1.5">
              {lecture.data.tags.map((tag) => (
                <span class="bg-muted text-muted-foreground rounded-md px-2 py-0.5 text-xs">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </div>

      <article class="prose">
        <Content />
      </article>

      {
        pdfHref && (
          <div class="mx-auto mt-10 w-[90%]">
            <a
              href={pdfHref}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted-foreground hover:text-foreground text-sm"
            >
              Open PDF in new tab &rarr;
            </a>
            <iframe
              src={pdfHref}
              class="mt-3 w-full rounded-md border"
              style="height: 80vh;"
              loading="lazy"
            />
          </div>
        )
      }

      {
        fileTree.length > 0 && (
          <section class="mt-12 border-t pt-6">
            <h2 class="text-2xl font-semibold">Course Materials</h2>
            <div class="mt-4">
              <FileTree nodes={fileTree} />
            </div>
          </section>
        )
      }

      <div class="mt-12 border-t pt-6">
        <Link
          href="/lectures"
          class="text-muted-foreground hover:text-foreground text-sm"
        >
          &larr; Back to all lectures
        </Link>
      </div>
    </div>
  </section>
</Layout>
