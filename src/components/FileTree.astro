---
import type { TreeNode } from '@/lib/file-tree'
import FileTree from './FileTree.astro'

interface Props {
  nodes: TreeNode[]
  depth?: number
}
const { nodes, depth = 0 } = Astro.props
const ext = (name: string) => (name.includes('.') ? name.split('.').pop()!.toLowerCase() : '')
---

<ul class="tree" role="list">
  {
    nodes.map((node) =>
      node.type === 'dir' ? (
        <li>
          <details open={depth === 0}>
            <summary>
              <span class="tree__dir">{node.name}</span>
              <span class="tree__count">{node.children?.length ?? 0}</span>
            </summary>
            <FileTree nodes={node.children ?? []} depth={depth + 1} />
          </details>
        </li>
      ) : (
        <li>
          <a
            class="tree__file"
            href={node.href}
            target="_blank"
            rel="noopener noreferrer"
            download={ext(node.name) !== 'pdf' || undefined}
          >
            <span class="tree__ext">{ext(node.name) || '·'}</span>
            <span class="sweep">{node.name}</span>
          </a>
        </li>
      ),
    )
  }
</ul>

<style>
  .tree {
    display: grid;
    gap: 0.3rem;
    font-size: 1rem;
  }
  .tree .tree {
    margin: 0.4rem 0 0.4rem 0.45rem;
    padding-left: 1.1rem;
    border-left: 1px solid var(--rule);
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    width: fit-content;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before {
    content: '▸';
    color: var(--muted);
    transition: rotate 0.25s var(--ease);
    display: inline-block;
  }
  details[open] > summary::before {
    rotate: 90deg;
  }
  .tree__dir {
    font-style: italic;
  }
  .tree__count {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .tree__file {
    display: inline-flex;
    gap: 0.75rem;
    align-items: baseline;
    text-decoration: none;
  }
  .tree__ext {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    color: var(--muted);
    min-width: 3.5ch;
  }
</style>
