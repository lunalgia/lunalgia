---
interface Props {
  home?: boolean
}
const { home = false } = Astro.props
---

{
  !home && (
    <nav class="chrome" aria-label="site">
      <a class="chrome__home" href="/" transition:name="home-mark">
        <span class="chrome__arrow" aria-hidden="true">←</span> <em>lunalgia</em>
      </a>
    </nav>
  )
}

<script>
  const watch = () => {
    const bar = document.querySelector<HTMLElement>('.chrome')
    if (!bar) return
    const update = () => bar.classList.toggle('is-scrolled', scrollY > 8)
    update()
    addEventListener('scroll', update, { passive: true })
    document.addEventListener('astro:before-swap', () => removeEventListener('scroll', update), { once: true })
  }
  document.addEventListener('astro:page-load', watch)
</script>

<style>
  /* a band of the page colour that thins out downwards, so text scrolls away under it */
  .chrome {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto 0;
    display: flex;
    align-items: flex-start;
    height: 4rem;
    /* level with the frame's top hairline and the labels on it */
    padding: calc(var(--frame-inset) - 0.75rem) calc(var(--frame-inset) + 1.25rem) 0;
    pointer-events: none;
    font-size: 1rem;
  }
  .chrome::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      var(--chrome-bg, var(--bg)) 0%,
      color-mix(in oklab, var(--chrome-bg, var(--bg)) 85%, transparent) 40%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(to bottom, #000 35%, transparent);
    mask-image: linear-gradient(to bottom, #000 35%, transparent);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  /* only once something has scrolled under it */
  .chrome.is-scrolled::before {
    opacity: 1;
  }
  .chrome > * {
    pointer-events: auto;
  }
  .chrome a {
    color: var(--ink);
    text-decoration: none;
    padding-inline: 0.625rem;
    margin-inline: -0.625rem;
    transition: background-color 0.4s var(--ease);
  }
  /* on a framed page, sit on the hairline like its labels do, with the same
     patch of paper; once the page scrolls the frame is gone and so is the patch */
  :global(:root:has(.intro.frame)) .chrome:not(.is-scrolled) a {
    background: var(--bg);
  }
  .chrome__arrow {
    display: inline-block;
    transition: translate 0.3s var(--ease);
  }
  .chrome__home:hover .chrome__arrow {
    translate: -3px 0;
  }
  .chrome__home:hover em {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
</style>
