---
/**
 * Board 3: "Hello, I go by Lilian" laid across a dithered painting. The part
 * of the line that crosses the picture is white: a second copy of the line sits
 * inside the picture's clip, at the same place, so the split is exact at any
 * size and survives the reveal animation.
 *
 * Reveal ("phase in"): the painting is simply there; each letter of the line
 * arrives from a soft blur, 28 ms after the one before. Both copies carry the
 * same letters with the same delays, so the white part stays exact throughout.
 */
import { Image } from 'astro:assets'
import cobweb from '@/assets/home/cobweb.png'

const line = 'Hello, I go by Lilian'
const letters = [...line]
---

<section id="hello" class="hello board" aria-label={line}>
  <p class="hello__line hello__line--ink" aria-hidden="true">{letters.map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</p>
  <div class="hello__frame">
    <div class="hello__pic">
      <Image src={cobweb} alt="" width={520} densities={[1, 2]} loading="lazy" />
    </div>
    <p class="hello__line hello__line--light" aria-hidden="true">{letters.map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</p>
  </div>
  <h2 class="visually-hidden">{line}</h2>
</section>

<script>
  /**
   * Arm the reveal when JS runs (so nothing is hidden without it), play it once
   * when a third of the board is in view. Reduced motion: no reveal at all.
   */
  const init = () => {
    const root = document.querySelector<HTMLElement>('.hello')
    if (!root || root.dataset.ready) return
    root.dataset.ready = '1'
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
    root.classList.add('is-armed')
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return
        root.classList.add('is-in')
        io.disconnect()
      },
      { threshold: 0.35 },
    )
    io.observe(root)
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true })
  }

  document.addEventListener('astro:page-load', init)
</script>

<style>
  .hello {
    /* phones: a 1000-unit board; wide screens: the 1920 board */
    --bw: 1000;
    /* the board's picture and line at 85% of the drawing, about the picture's centre */
    --img-x: 240.75;
    --img-y: 138.4;
    --img-w: 518.5;
    --img-h: 775.2;
    --fs: 88.4;
    --line-y: 554.9;
    --u: calc(100cqi / var(--bw));
    aspect-ratio: 1000 / 1060;
  }
  @media (min-aspect-ratio: 4/3) {
    .hello {
      --bw: 1920;
      --img-x: 701.6;
      --img-y: 164.18;
      --img-w: 516.8;
      --img-h: 771.8;
      --fs: 124.5;
      --line-y: 576.73;
      aspect-ratio: 16 / 9;
    }
  }

  .hello__frame {
    position: absolute;
    left: calc(var(--img-x) * var(--u));
    top: calc(var(--img-y) * var(--u));
    width: calc(var(--img-w) * var(--u));
    height: calc(var(--img-h) * var(--u));
    overflow: hidden;
  }
  .hello__pic,
  .hello__pic :global(img) {
    width: 100%;
    height: 100%;
  }
  .hello__pic :global(img) {
    object-fit: cover;
    image-rendering: pixelated;
  }

  .hello__line {
    position: absolute;
    margin: 0;
    white-space: nowrap;
    /* Instrument Serif italic, as the site's other display lines. It is narrower
       than the Fraunces it replaces, so it is set 25% larger to span the board */
    font-family: var(--font-display);
    font-style: italic;
    font-size: calc(var(--fs) * var(--u) * 1.25);
    line-height: 1;
    /* place the baseline on --line-y (Instrument's sits 0.84em below the top of its line box) */
    top: calc(var(--line-y) * var(--u) - 0.9085em);
    /* each copy spans the whole board and centres the text in it, so the line
       sits in the middle (as the picture does) whatever its rendered width */
    width: calc(var(--bw) * var(--u));
    text-align: center;
    pointer-events: none;
  }
  .hello__line--ink {
    left: 0;
    color: var(--ultramarine);
  }
  /* the reveal: armed by JS only, so nothing is hidden without it. Letters are
     inline blocks so they can blur and move; spaces keep their width. */
  .hello__line span {
    display: inline-block;
    white-space: pre;
  }
  .hello.is-armed .hello__line span {
    opacity: 0;
    filter: blur(0.12em);
    transform: translateY(0.05em);
  }
  .hello.is-in .hello__line span {
    opacity: 1;
    filter: none;
    transform: none;
    transition:
      opacity 0.9s var(--ease-out),
      filter 0.9s var(--ease-out),
      transform 0.9s var(--ease-out);
    transition-delay: calc(0.3s + var(--i) * 28ms);
  }
  .hello__line--light {
    left: calc(var(--img-x) * var(--u) * -1);
    top: calc((var(--line-y) - var(--img-y)) * var(--u) - 0.9085em);
    color: #fff;
  }
</style>
