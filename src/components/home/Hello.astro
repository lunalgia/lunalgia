---
/**
 * Board 3: "Hello, I go by Lilian" laid across a dithered painting. The part
 * of the line that crosses the picture is white: a second copy of the line sits
 * inside the picture's clip, at the same place, so the split is exact at any
 * size and survives the reveal animation.
 */
import { Image } from 'astro:assets'
import cobweb from '@/assets/home/cobweb.png'

const line = 'Hello, I go by Lilian'
---

<section id="hello" class="hello board" aria-label={line}>
  <p class="hello__line hello__line--ink" aria-hidden="true">{line}</p>
  <div class="hello__frame">
    <div class="hello__pic">
      <Image src={cobweb} alt="" width={608} densities={[1, 2]} loading="lazy" />
    </div>
    <p class="hello__line hello__line--light" aria-hidden="true">{line}</p>
  </div>
  <h2 class="visually-hidden">{line}</h2>
</section>

<script>
  /**
   * One quiet reveal when the board comes into view: the painting fades up from
   * a hair larger, then the line rises into place. Only opacity and transform
   * move, so it runs on the compositor (the old clip-path + scrubbed parallax
   * repainted the image every frame and stuttered under smooth scrolling).
   * Without JS, or with reduced motion, everything is simply there.
   */
  const init = () => {
    const root = document.querySelector<HTMLElement>('.hello')
    if (!root || root.dataset.ready) return
    root.dataset.ready = '1'
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return root.classList.add('is-in')
    root.classList.add('is-armed')
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return
        root.classList.add('is-in')
        io.disconnect()
      },
      { threshold: 0.35 },
    )
    io.observe(root)
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true })
  }

  document.addEventListener('astro:page-load', init)
</script>

<style>
  .hello {
    /* phones: a 1000-unit board; wide screens: the 1920 board */
    --bw: 1000;
    --img-x: 195;
    --img-y: 70;
    --img-w: 610;
    --img-h: 912;
    --fs: 104;
    --line-y: 560;
    --u: calc(100cqi / var(--bw));
    aspect-ratio: 1000 / 1060;
  }
  @media (min-aspect-ratio: 4/3) {
    .hello {
      --bw: 1920;
      --img-x: 656;
      --img-y: 96.08;
      --img-w: 608;
      --img-h: 908;
      --fs: 146.5;
      --line-y: 581.43;
      aspect-ratio: 16 / 9;
    }
  }

  .hello__frame {
    position: absolute;
    left: calc(var(--img-x) * var(--u));
    top: calc(var(--img-y) * var(--u));
    width: calc(var(--img-w) * var(--u));
    height: calc(var(--img-h) * var(--u));
    overflow: hidden;
  }
  .hello__pic,
  .hello__pic :global(img) {
    width: 100%;
    height: 100%;
  }
  .hello__pic :global(img) {
    object-fit: cover;
    image-rendering: pixelated;
  }

  .hello__line {
    position: absolute;
    margin: 0;
    white-space: nowrap;
    font-family: var(--font-fraunces);
    font-style: italic;
    font-size: calc(var(--fs) * var(--u));
    line-height: 1;
    /* a lower optical size thickens Fraunces' hairlines; at its display size
       the bar of the H is thinner than a pixel and vanishes on smaller screens */
    font-variation-settings:
      'opsz' 60,
      'wght' 190,
      'SOFT' 0,
      'WONK' 1;
    /* place the baseline (≈ 0.98em below the top of the line box) on --line-y */
    top: calc(var(--line-y) * var(--u) - 0.93em);
    /* each copy spans the whole board and centres the text in it, so the line
       sits in the middle (as the picture does) whatever its rendered width */
    width: calc(var(--bw) * var(--u));
    text-align: center;
    pointer-events: none;
  }
  .hello__line--ink {
    left: 0;
    color: var(--ultramarine);
  }
  /* the reveal: armed by JS only, so nothing is hidden without it */
  .hello.is-armed .hello__pic {
    opacity: 0;
    transform: scale(1.035);
  }
  .hello.is-armed .hello__line {
    opacity: 0;
    transform: translateY(0.12em);
  }
  .hello.is-in .hello__pic,
  .hello.is-in .hello__line {
    opacity: 1;
    transform: none;
  }
  .hello__pic {
    transition:
      opacity 1.4s var(--ease-out),
      transform 2.4s var(--ease-out);
  }
  /* both copies move as one, so the white part stays on the picture */
  .hello__line {
    transition:
      opacity 1.2s var(--ease-out) 0.35s,
      transform 1.6s var(--ease-out) 0.35s;
  }
  .hello__line--light {
    left: calc(var(--img-x) * var(--u) * -1);
    top: calc((var(--line-y) - var(--img-y)) * var(--u) - 0.93em);
    color: #fff;
  }
</style>
