---
/**
 * The status line, after henry.codes: the bottom edge of the hero frame
 * becomes a slow ticker. Weather, time and moon are worked out in the
 * browser; the rest comes from src/data/now.md.
 */
import { frontmatter as now } from '@/data/now.md'

const items: { label: string; value?: string; slot?: string }[] = [
  { label: '—°C', value: `${now.place}, ${now.coords}`, slot: 'weather' },
  { label: '—:— IST', slot: 'time' },
  { label: 'MOON', value: '…', slot: 'moon' },
  ...(now.reading ? [{ label: 'NOW READING', value: now.reading }] : []),
  ...(now.listening ? [{ label: 'ON REPEAT', value: now.listening }] : []),
  ...(now.studying ? [{ label: 'STUDYING', value: now.studying }] : []),
]
---

<div class="sbar" data-lat={now.latitude} data-lon={now.longitude} role="status" aria-live="off">
  <div class="sbar__track">
    {
      [0, 1].map((copy) => (
        <p class="sbar__run" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((it) => (
            <span class="sbar__item">
              <span class="sbar__label" data-slot={it.slot && `${it.slot}-label`}>
                — {it.label}
              </span>
              {it.value !== undefined && (
                <span class="sbar__value" data-slot={it.slot && `${it.slot}-value`}>
                  {it.value}
                </span>
              )}
            </span>
          ))}
        </p>
      ))
    }
  </div>
</div>

<script>
  const WEATHER: [number[], string][] = [
    [[0], 'CLEAR'],
    [[1, 2], 'FAIR'],
    [[3], 'OVERCAST'],
    [[45, 48], 'FOG'],
    [[51, 53, 55, 56, 57], 'DRIZZLE'],
    [[61, 63, 65, 66, 67, 80, 81, 82], 'RAIN'],
    [[95, 96, 99], 'THUNDER'],
  ]
  const PHASES = [
    'new moon',
    'waxing crescent',
    'first quarter',
    'waxing gibbous',
    'full moon',
    'waning gibbous',
    'last quarter',
    'waning crescent',
  ]

  const set = (root: HTMLElement, slot: string, text: string) =>
    root.querySelectorAll(`[data-slot="${slot}"]`).forEach((el) => (el.textContent = text))

  const moon = () => {
    const SYN = 29.530588853
    const ref = Date.UTC(2000, 0, 6, 18, 14) // a known new moon
    const age = ((((Date.now() - ref) / 86400000) % SYN) + SYN) % SYN
    const lit = Math.round(((1 - Math.cos((2 * Math.PI * age) / SYN)) / 2) * 100)
    return `${PHASES[Math.round((age / SYN) * 8) % 8]}, ${lit}%`
  }

  /**
   * The ticker: one run's width per loop at a steady speed in pixels, driven by
   * the Web Animations API so it runs on the compositor.
   *
   * Its position is a function of the wall clock (seconds since the epoch times
   * the speed, modulo the run's width), so leaving the page and coming back, or
   * reloading, finds the bar where it would have been, instead of starting it
   * over from the left. When the run changes width (the weather arriving, a font
   * swapping in) the animation is rebuilt on the same clock.
   */
  const SPEED = 22 // px per second
  const ticker = (root: HTMLElement) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
    const track = root.querySelector<HTMLElement>('.sbar__track')!
    const run = root.querySelector<HTMLElement>('.sbar__run')!
    let anim: Animation | null = null
    let width = 0
    let hovered = false
    const clock = (w: number) => ((((performance.timeOrigin + performance.now()) / 1000) * SPEED) % w) / SPEED * 1000
    const build = () => {
      const w = run.offsetWidth
      if (!w || w === width) return
      anim?.cancel()
      width = w
      anim = track.animate([{ transform: 'translateX(0)' }, { transform: `translateX(${-w}px)` }], {
        duration: (w / SPEED) * 1000,
        iterations: Infinity,
      })
      anim.currentTime = clock(w)
      if (hovered) anim.pause()
    }
    const ro = new ResizeObserver(build)
    ro.observe(run)
    build()
    root.addEventListener('mouseenter', () => {
      hovered = true
      anim?.pause()
    })
    root.addEventListener('mouseleave', () => {
      hovered = false
      if (anim) anim.currentTime = clock(width) // back on the clock, as if it never stopped
      anim?.play()
    })
    document.addEventListener(
      'astro:before-swap',
      () => {
        ro.disconnect()
        anim?.cancel()
      },
      { once: true },
    )
  }

  /** the last weather reading, kept for half an hour so a visit does not start at "—°C" */
  const WEATHER_KEY = 'lunalgia:weather'
  const cached = (): string | null => {
    try {
      const v = JSON.parse(localStorage.getItem(WEATHER_KEY) ?? 'null')
      return v && Date.now() - v.at < 30 * 60 * 1000 ? v.label : null
    } catch {
      return null
    }
  }
  const remember = (label: string) => {
    try {
      localStorage.setItem(WEATHER_KEY, JSON.stringify({ label, at: Date.now() }))
    } catch {}
  }

  const init = () => {
    const root = document.querySelector<HTMLElement>('.sbar')
    if (!root || root.dataset.ready) return
    root.dataset.ready = '1'
    ticker(root)

    const clock = () =>
      set(
        root,
        'time-label',
        `— ${new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Kolkata' }).format(new Date())} IST`,
      )
    clock()
    const timer = setInterval(clock, 20000)
    document.addEventListener('astro:before-swap', () => clearInterval(timer), { once: true })
    set(root, 'moon-value', moon())

    const known = cached()
    if (known) return set(root, 'weather-label', known)

    const { lat, lon } = root.dataset
    fetch(
      `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,weather_code&timezone=Asia%2FKolkata`,
    )
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        const c = d?.current
        if (!c) return
        const word = WEATHER.find(([codes]) => codes.includes(c.weather_code))?.[1]
        const label = `— ${Math.round(c.temperature_2m)}°C${word ? `, ${word}` : ''}`
        set(root, 'weather-label', label)
        remember(label)
      })
      .catch(() => {})
  }
  document.addEventListener('astro:page-load', init)
</script>

<style>
  .sbar {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2.6rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-block: 1.5px solid var(--ultramarine);
    background: var(--lavender);
    color: var(--ultramarine);
  }
  .sbar__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .sbar__run {
    margin: 0;
    white-space: nowrap;
    padding-left: 0.9rem;
  }
  .sbar__item {
    margin-right: 1.7em;
  }
  .sbar__label {
    font-variant-numeric: tabular-nums;
    font-family: var(--font-din);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    margin-right: 0.75em;
  }
  .sbar__value {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
  }

  /* wide: the frame's bottom edge is the bar's top rule */
  @media (min-aspect-ratio: 4/3) {
    .sbar {
      left: calc(100% * 44.5 / 1920);
      right: calc(100% * 45.3 / 1920);
      top: calc(100% * 1035 / 1080);
      bottom: auto;
      height: max(2.3rem, calc(100vw * 52 / 1920));
      border-top-width: 1.93px;
    }
    .sbar__label {
      font-size: max(0.66rem, calc(100vw * 17 / 1920));
    }
    .sbar__value {
      font-size: max(0.92rem, calc(100vw * 23 / 1920));
    }
  }
</style>
